{
  "name": "cubbie-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render:draft": "remotion render src/index.ts JobLedgerDraft output/animatic.mp4 --scale=0.5 --concurrency=3 --crf=25",
    "render:master": "remotion render src/index.ts JobLedgerLaunch output/render-master.mp4 --concurrency=3 --crf=16",
    "render:final": "npm run render:master && bash scripts/finish-film.sh",
    "stills": "node scripts/render-stills.mjs",
    "audio": "python3 scripts/synthesize-score.py && python3 scripts/master-audio.py",
    "capture": "node scripts/capture-film-assets.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
